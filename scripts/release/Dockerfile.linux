# Isolated Linux acceptance image: CUPS, Avahi, an IPP printer, Poppler for the
# PDF checks, and a full Python 3 for the acceptance script.
FROM debian:bookworm-slim
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      avahi-daemon cups-daemon cups-client cups-ipp-utils cups-filters cups-core-drivers \
      dbus poppler-utils python3 unzip \
    && rm -rf /var/lib/apt/lists/*
